{
  "name": "kinesis-exchange-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Kinesis KMS Exchange REST + WebSocket API, plus the Kinesis Pay merchant API.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradenbiz/kinesis-typescript-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./rest": {
      "types": "./dist/rest.d.ts",
      "import": "./dist/rest.js",
      "require": "./dist/rest.cjs"
    },
    "./withdrawal": {
      "types": "./dist/withdrawal.d.ts",
      "import": "./dist/withdrawal.js",
      "require": "./dist/withdrawal.cjs"
    },
    "./pay": {
      "types": "./dist/pay.d.ts",
      "import": "./dist/pay.js",
      "require": "./dist/pay.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example:kpay": "node --import tsx --env-file=.env examples/kpay-create-and-poll.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "socket.io-client": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "tsx": "^4.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
