KINESIS_PUBLIC_KEY=
KINESIS_PRIVATE_KEY=

KINESIS_MERCHANT_PUBLIC_KEY=
KINESIS_MERCHANT_PRIVATE_KEY=

# Kinesis Pay merchant API (used by examples/kpay-create-and-poll.ts and any
# consumer of `kinesis-exchange-sdk/pay`). Distinct from the exchange keys above.
KINESIS_PAY_ACCESS_TOKEN=
KINESIS_PAY_SECRET_TOKEN=
KINESIS_PAY_MERCHANT_ID=
# Set to 'qa' to hit qa4-api.kinesis.money instead of production.
KINESIS_PAY_ENV=